# MongoDB Connection String (Atlas cluster or local instance)
# Local: mongodb://127.0.0.1:27017/student_management_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student_management_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
